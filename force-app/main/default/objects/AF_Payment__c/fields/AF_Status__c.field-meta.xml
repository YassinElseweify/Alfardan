<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AF_Status__c</fullName>
    <description>Payment verification state. ALF-RS-08 FR12 gates Reservation Contract generation until the payment is Paid / Verified; before this field existed the gate had nothing to read. Pending = recorded but unconfirmed, Paid / Verified = cashier or finance has confirmed receipt, Rejected = proof rejected, Refunded = reversed after cancellation.</description>
    <label>Payment Status</label>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Pending</fullName>
                <default>true</default>
                <label>Pending</label>
            </value>
            <value>
                <fullName>Paid / Verified</fullName>
                <default>false</default>
                <label>Paid / Verified</label>
            </value>
            <value>
                <fullName>Rejected</fullName>
                <default>false</default>
                <label>Rejected</label>
            </value>
            <value>
                <fullName>Refunded</fullName>
                <default>false</default>
                <label>Refunded</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
