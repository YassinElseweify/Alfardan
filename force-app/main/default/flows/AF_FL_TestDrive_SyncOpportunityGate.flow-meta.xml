<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Any_Incomplete</name>
        <label>Any Incomplete Test Drives?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Clear_Gate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None Incomplete</defaultConnectorLabel>
        <rules>
            <name>Has_Incomplete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Incomplete_TestDrives</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Block_Gate</targetReference>
            </connector>
            <label>Has Incomplete</label>
        </rules>
    </decisions>
    <description>After-save on AF_TestDrive__c (paired with the before-save AF_FL_TestDrive_UpdateGate, which sets AF_StageGatePassed__c): queries all Test Drives linked to this record&apos;s Opportunity and sets Opportunity.AF_TestDriveGateBlocked__c = true if any still lack a passed gate, false otherwise. Read by AF_VR_Opp_TestDriveGate.</description>
    <environments>Default</environments>
    <interviewLabel>Test Drive Sync Opportunity Gate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test Drive Sync Opportunity Gate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Incomplete_TestDrives</name>
        <label>Get Incomplete Test Drives</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Incomplete</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AF_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AF_Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>AF_StageGatePassed__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AF_TestDrive__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Block_Gate</name>
        <label>Block Gate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AF_Opportunity__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AF_TestDriveGateBlocked__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Clear_Gate</name>
        <label>Clear Gate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AF_Opportunity__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AF_TestDriveGateBlocked__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Incomplete_TestDrives</targetReference>
        </connector>
        <object>AF_TestDrive__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
