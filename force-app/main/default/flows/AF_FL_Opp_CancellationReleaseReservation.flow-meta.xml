<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Collection</name>
        <label>Add To Collection</label>
        <locationX>176</locationX>
        <locationY>430</locationY>
        <assignmentItems>
            <assignToReference>col_ReservationsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Reservations</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Reservations</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Cancelled_Status</name>
        <label>Assign Cancelled Status</label>
        <locationX>176</locationX>
        <locationY>358</locationY>
        <assignmentItems>
            <assignToReference>Loop_Reservations.AF_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Collection</targetReference>
        </connector>
    </assignments>
    <description>QA fix (Defect #1, 2026-09-17): when an approved cancellation sets Opportunity.AF_SOStatus__c to Cancelled, this releases the linked Vehicle Reservation so the vehicle stock is not permanently locked. Cancels any non-terminal Reservation on the Opportunity, which in turn fires the existing AF_FL_Reservation_StockReleaseOnClose before-save flow to flag stock release, exactly as an Expired reservation already does.</description>
    <environments>Default</environments>
    <interviewLabel>Opp Cancellation Release Reservation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp Cancellation Release Reservation</label>
    <loops>
        <name>Loop_Reservations</name>
        <label>Loop Reservations</label>
        <locationX>176</locationX>
        <locationY>258</locationY>
        <collectionReference>Get_Open_Reservations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Cancelled_Status</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Reservations</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Reservations</name>
        <label>Get Open Reservations</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Reservations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AF_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AF_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>AF_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AF_VehicleReservation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Reservations</name>
        <label>Update Reservations</label>
        <locationX>176</locationX>
        <locationY>558</locationY>
        <inputReference>col_ReservationsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Reservations</targetReference>
        </connector>
        <filterFormula>AND(
  ISPICKVAL({!$Record.AF_SOStatus__c}, &quot;Cancelled&quot;),
  ISCHANGED({!$Record.AF_SOStatus__c})
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>col_ReservationsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AF_VehicleReservation__c</objectType>
    </variables>
</Flow>
