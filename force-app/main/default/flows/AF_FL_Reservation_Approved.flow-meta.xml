    <description>Fires when AF_ApprovalStatus__c changes to Approved. Sets AF_Status__c to Reserved (unless already terminal), since a Pending-Approval reservation getting approved is the one status transition AF_FL_Reservation_EvaluateApproval&apos;s before-save trigger conditions can never catch - that flow only fires on Contract Type/Deposit/Extension changes, not on the approval process&apos;s own field update. Notifies the Reservation Owner via email and Custom Notification - same dual-channel pattern as AF_FL_Opp_LostApproved.</description>
    <environments>Default</environments>
    <formulas>
        <name>AF_Formula_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Approved: Vehicle Reservation &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>NotifBody</name>
        <dataType>String</dataType>
        <expression>&quot;Your Vehicle Reservation request for &quot; &amp; {!$Record.Name} &amp; &quot; was approved.&quot;</expression>
    </formulas>
    <formulas>
        <name>NotifTitle</name>
        <dataType>String</dataType>
        <expression>&quot;Reservation Approved: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <interviewLabel>Reservation Approved {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reservation Approved</label>
