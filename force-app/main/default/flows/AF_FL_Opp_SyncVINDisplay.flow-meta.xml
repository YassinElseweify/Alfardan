<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Quote</name>
        <label>Does This Opportunity Have a Quote?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Quote</defaultConnectorLabel>
        <rules>
            <name>Quote_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Quote_item</targetReference>
            </connector>
            <label>Quote Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Vehicle_in_Stock</name>
        <label>Is Vehicle in Stock ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>In_Stock</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Selected_Vehicle.AF_InventoryStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Stock</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Quote_VIN</targetReference>
            </connector>
            <label>In-Stock</label>
        </rules>
    </decisions>
    <description>Single Opportunity-level owner of AF_VINDisplay__c population. Fires whenever Opportunity.AF_SelectedVehicle__c changes (populated, changed to a different Vehicle, or cleared) — including a direct field edit, not just the Select Vehicle action, which is the gap this flow closes. Looks up the selected Vehicle (if any) and its inventory status via Formula_VINValue: In Stock pushes its VIN onto this Opportunity&apos;s Quote, anything else (In Transit, Ordered, or no Vehicle selected at all) blanks it. Does not create or modify any OpportunityLineItem or QuoteLineItem — VIN display only. Mirrors AF_FL_Vehicle_SyncVINOnRestock&apos;s pattern (one record-triggered flow per object): that flow owns the reverse direction (Vehicle.AF_InventoryStatus__c changing propagates to every Quote already referencing that Vehicle via QuoteLineItem.AF_Vehicle__c); this flow owns the Opportunity.AF_SelectedVehicle__c direction.</description>
    <environments>Default</environments>
    <formulas>
        <name>Formula_VINValue</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!Get_Selected_Vehicle.AF_InventoryStatus__c}, &quot;In Stock&quot;), {!Get_Selected_Vehicle.VehicleIdentificationNumber}, &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>Opportunity Sync VIN Display {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Sync VIN Display</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote</name>
        <label>Get Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Selected_Vehicle</name>
        <label>Get Selected Vehicle</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AF_SelectedVehicle__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Quote_item</name>
        <label>Update Quote item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Vehicle_in_Stock</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Product2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Selected_Vehicle.VehicleDefinition.ProductId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AF_VehicleDefinition__c</field>
            <value>
                <elementReference>Get_Selected_Vehicle.VehicleDefinitionId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_Vehicle__c</field>
            <value>
                <elementReference>Get_Selected_Vehicle.Id</elementReference>
            </value>
        </inputAssignments>
        <object>QuoteLineItem</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Quote_VIN</name>
        <label>Update Quote VIN</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AF_VINDisplay__c</field>
            <value>
                <elementReference>Formula_VINValue</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Selected_Vehicle</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.AF_SelectedVehicle__c})</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
