<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decide_Quote_Still_Open</name>
        <label>Quote Still Open?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Update_Quote_Denied</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Open (Draft/Presented/Accepted)</defaultConnectorLabel>
        <rules>
            <name>Already_Denied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Synced_Quote.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Denied</stringValue>
                </rightValue>
            </conditions>
            <label>Already Denied</label>
        </rules>
    </decisions>
    <description>Retail Cycle - when a deal is formally Closed Lost (AF_LostApprovalStatus__c=Approved) or its Cancellation is approved (AF_SOStatus__c=Cancelled), the Quote it was built on is no longer a live working number, so its Status moves to Denied. Completes the Quote status walking automatically with the deal cycle, alongside AF_FL_Quote_StatusFollowsCycle (Draft-&gt;Presented) and AF_FL_Reservation_SyncQuoteAccepted (-&gt;Accepted).</description>
    <environments>Default</environments>
    <interviewLabel>Opp Deny Quote On Lost Or Cancel {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp Deny Quote On Lost Or Cancel</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Synced_Quote</name>
        <label>Get Synced Quote</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decide_Quote_Still_Open</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsSyncing</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Quote_Denied</name>
        <label>Update Quote Denied</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Synced_Quote.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Denied</stringValue>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Synced_Quote</targetReference>
        </connector>
        <filterFormula>OR(
  AND(ISCHANGED({!$Record.AF_LostApprovalStatus__c}), ISPICKVAL({!$Record.AF_LostApprovalStatus__c}, &quot;Approved&quot;)),
  AND(ISCHANGED({!$Record.AF_SOStatus__c}), ISPICKVAL({!$Record.AF_SOStatus__c}, &quot;Cancelled&quot;))
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
