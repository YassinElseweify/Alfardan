        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Formula_DeclineRemark</name>
        <dataType>String</dataType>
        <expression>&quot;Vehicle &quot; &amp; {!$Record.AppraisalItemNumber} &amp; &quot; (&quot; &amp; TEXT({!$Record.MakeName}) &amp; &quot; &quot; &amp; TEXT({!$Record.ModelName}) &amp; &quot;) declined by rep.&quot;</expression>
    </formulas>
