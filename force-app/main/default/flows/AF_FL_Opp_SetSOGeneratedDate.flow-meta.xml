<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Stamps AF_SOGeneratedDate__c the moment AF_SOStatus__c transitions to Generated (passing AF_VR_Opp_SOGenerationGate). Before-save, no extra DML.</description>
    <environments>Default</environments>
    <interviewLabel>Opp Set SO Generated Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp Set SO Generated Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Generated_Date</name>
        <label>Set SO Generated Date</label>
        <locationX>50</locationX>
        <locationY>134</locationY>
        <inputAssignments>
            <field>AF_SOGeneratedDate__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Generated_Date</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.AF_SOStatus__c}) &amp;&amp; ISPICKVAL({!$Record.AF_SOStatus__c}, &quot;Generated&quot;) &amp;&amp; ISBLANK({!$Record.AF_SOGeneratedDate__c})</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>20</triggerOrder>
</Flow>
