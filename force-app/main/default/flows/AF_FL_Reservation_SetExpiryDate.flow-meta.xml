<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Clear_Expiry</name>
        <label>Clear Expiry (VIP)</label>
        <locationX>302</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>$Record.AF_ExpiryDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_EmptyDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Expiry_3Day</name>
        <label>Set Expiry (3-Day)</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>$Record.AF_ExpiryDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>AF_Formula_Expiry3Day</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Expiry_7Day</name>
        <label>Set Expiry (7-Day)</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>$Record.AF_ExpiryDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>AF_Formula_Expiry7Day</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decide_Contract_Type</name>
        <label>Contract Type?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Clear_Expiry</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>VIP / Extended</defaultConnectorLabel>
        <rules>
            <name>ThreeDay</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AF_ContractType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>3-Day (No Deposit)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Expiry_3Day</targetReference>
            </connector>
            <label>3-Day</label>
        </rules>
        <rules>
            <name>SevenDay</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AF_ContractType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>7-Day (Deposit)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Expiry_7Day</targetReference>
            </connector>
            <label>7-Day</label>
        </rules>
    </decisions>
    <description>Before-save on AF_VehicleReservation__c: derives AF_ExpiryDate__c from AF_StartDate__c + contract duration (3-Day -&gt; +3 plus any FR8c AF_RequestedExtraDays__c, 7-Day -&gt; +7). VIP/Extended is left blank until the approving manager sets it directly (FR3/AC3 - see AF_VR_VIPExpiryRequiredOnApproval) - AF_FL_Reservation_ExpiryAutomation&apos;s scheduled paths never fire for a blank date, so a VIP reservation gets no reminders/expiry until that happens.</description>
    <environments>Default</environments>
    <formulas>
        <name>AF_Formula_Expiry3Day</name>
        <dataType>Date</dataType>
        <expression>{!$Record.AF_StartDate__c} + 3 + IF(ISBLANK({!$Record.AF_RequestedExtraDays__c}), 0, {!$Record.AF_RequestedExtraDays__c})</expression>
    </formulas>
    <formulas>
        <name>AF_Formula_Expiry7Day</name>
        <dataType>Date</dataType>
        <expression>{!$Record.AF_StartDate__c} + 7</expression>
    </formulas>
    <interviewLabel>Reservation Set Expiry Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reservation Set Expiry Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decide_Contract_Type</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.AF_StartDate__c}), ISCHANGED({!$Record.AF_ContractType__c}), ISCHANGED({!$Record.AF_RequestedExtraDays__c}))</filterFormula>
        <object>AF_VehicleReservation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_EmptyDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
