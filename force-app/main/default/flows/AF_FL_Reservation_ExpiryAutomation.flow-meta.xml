<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Still_Open_Expire</name>
        <label>Still Open (Not Converted/Cancelled)?</label>
        <locationX>302</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Closed - No Action</defaultConnectorLabel>
        <rules>
            <name>Open_For_Expiry</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AF_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Converted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AF_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AF_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Expired</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Expired</targetReference>
            </connector>
            <label>Open</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Still_Open_Reminder</name>
        <label>Still Open (Not Converted/Cancelled)?</label>
        <locationX>50</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Closed - No Reminder</defaultConnectorLabel>
        <rules>
            <name>Open_For_Reminder</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AF_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Converted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AF_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AF_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Expired</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Reminder_Task</targetReference>
            </connector>
            <label>Open</label>
        </rules>
    </decisions>
    <description>Scheduled Paths anchored on AF_ExpiryDate__c (set by AF_FL_Reservation_SetExpiryDate; blank for VIP/Extended, so those correctly get no reminders or auto-expiry per FR16). KNOWN SIMPLIFICATION: BRD&apos;s baseline is daily (3-day contracts) or daily/every-other-day (7-day) reminders - true recurring daily reminders need a scheduled Apex batch job, out of scope for this pass. This builds a single &quot;1 day before expiry&quot; reminder touchpoint instead, plus the auto-expire/stock-release-flag transition on the expiry date itself. Never touches Converted or Cancelled reservations. Stock release is set to &quot;Pending Release&quot;, not &quot;Released&quot; - actual release confirmation is Keyloop-owned, same pattern as invoicing.</description>
    <environments>Default</environments>
    <interviewLabel>Reservation Expiry Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reservation Expiry Automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Reminder_Task</name>
        <label>Create Reminder Task</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Reservation Expiring Tomorrow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordUpdates>
        <name>Set_Expired</name>
        <label>Set Expired and Flag Stock Release</label>
        <locationX>302</locationX>
        <locationY>242</locationY>
        <inputAssignments>
            <field>AF_Status__c</field>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_StockReleaseStatus__c</field>
            <value>
                <stringValue>Pending Release</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterFormula>NOT(ISBLANK({!$Record.AF_ExpiryDate__c}))</filterFormula>
        <object>AF_VehicleReservation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Path_Reminder_1Day_Before</name>
            <connector>
                <targetReference>Check_Still_Open_Reminder</targetReference>
            </connector>
            <label>Reminder (1 Day Before Expiry)</label>
            <offsetNumber>-1</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>AF_ExpiryDate__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Path_Expire_On_ExpiryDate</name>
            <connector>
                <targetReference>Check_Still_Open_Expire</targetReference>
            </connector>
            <label>Expire (On Expiry Date)</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>AF_ExpiryDate__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
