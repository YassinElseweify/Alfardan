    <description>Fires when AF_LostApprovalStatus__c changes to Pending — i.e. whenever a Closed Lost request is actually submitted, regardless of how (Screen Flow, Apex, data load). Notifies the approver (AF_ApprovalRecipient__c, set by AF_FL_Opp_RequestClosure to the Owner&apos;s Manager) via a branded HTML email (native Send Email / emailSimple action, not the Approval Process&apos;s own emailTemplate — that mechanism doesn&apos;t reliably deliver HTML in this org) and via a Custom Notification. This logic used to live inside AF_FL_Opp_RequestClosure&apos;s Screen Flow, which meant it only fired on a real UI click and could never be exercised by Apex (Flow.Interview.start() rejects Screen Flow process type) — moved here to match the same record-triggered pattern already used for the Approved/Rejected notifications and to actually be testable.</description>
    <environments>Default</environments>
    <formulas>
        <name>EmailBody_ApprovalRequested</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;html&gt;&lt;body style=&quot;margin:0;padding:16px;background-color:#F4F4F6;font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;center&gt;&lt;table role=&quot;presentation&quot; align=&quot;center&quot; width=&quot;100%&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot;&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;&lt;table role=&quot;presentation&quot; align=&quot;center&quot; width=&quot;100%&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;max-width:560px;width:100%;background-color:#FFFFFF;border-radius:6px;border:1px solid #E2E5EA;border-top:4px solid #0B2545;margin:0 auto;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:24px 24px 8px 24px;&quot;&gt;&lt;span style=&quot;display:inline-block;background-color:#FCEFC7;color:#8A6D00;font-size:12px;font-weight:bold;letter-spacing:0.04em;text-transform:uppercase;padding:4px 10px;border-radius:3px;&quot;&gt;Action Required&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 24px 0 24px;&quot;&gt;&lt;h2 style=&quot;margin:0;font-size:19px;color:#0B2545;&quot;&gt;A Closed Lost request needs your approval&lt;/h2&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:16px 24px 4px 24px;&quot;&gt;&lt;table role=&quot;presentation&quot; width=&quot;100%&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#6B7280;font-size:13px;width:120px;&quot;&gt;Opportunity&lt;/td&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#1A1A1A;font-size:14px;&quot;&gt;&apos; &amp; {!$Record.Name} &amp; &apos;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#6B7280;font-size:13px;&quot;&gt;Account&lt;/td&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#1A1A1A;font-size:14px;&quot;&gt;&apos; &amp; {!Get_Account.Name} &amp; &apos;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#6B7280;font-size:13px;&quot;&gt;Owner&lt;/td&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#1A1A1A;font-size:14px;&quot;&gt;&apos; &amp; {!Get_Owner_User.Name} &amp; &apos;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#6B7280;font-size:13px;&quot;&gt;Lost Reason&lt;/td&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#1A1A1A;font-size:14px;&quot;&gt;&apos; &amp; TEXT({!$Record.AF_LostReason__c}) &amp; &apos;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px 0;color:#6B7280;font-size:13px;&quot;&gt;Notes&lt;/td&gt;&lt;td style=&quot;padding:10px 0;color:#1A1A1A;font-size:14px;&quot;&gt;&apos; &amp; {!$Record.AF_LostNotes__c} &amp; &apos;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:20px 24px 24px 24px;&quot;&gt;&lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; align=&quot;center&quot; style=&quot;margin:0 auto;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border-radius:4px;background-color:#0B2545;&quot;&gt;&lt;a href=&quot;&apos; &amp; {!Var_ApprovalLink} &amp; &apos;&quot; target=&quot;_blank&quot; style=&quot;display:inline-block;padding:12px 22px;font-size:14px;font-weight:bold;color:#FFFFFF;text-decoration:none;&quot;&gt;Review Approval Request&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:16px 24px;background-color:#FAFAFB;border-top:1px solid #EDEEF1;&quot;&gt;&lt;p style=&quot;margin:0;font-size:12px;color:#9AA0AC;&quot;&gt;Alfardan Group CRM - This is an automated notification.&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/center&gt;&lt;/body&gt;&lt;/html&gt;&apos;</expression>
