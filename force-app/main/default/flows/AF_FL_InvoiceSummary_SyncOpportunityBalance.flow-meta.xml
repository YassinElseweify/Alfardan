<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Total</name>
        <label>Add To Total</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>var_TotalBalance</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Invoice_Summaries.AF_Balance__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Invoice_Summaries</targetReference>
        </connector>
    </assignments>
    <description>After-save on AF_InvoiceSummary__c: sums AF_Balance__c across every Invoice Summary linked to the same Opportunity (handles the normal 1:1 case and any multi-invoice edge case identically) and pushes the total to Opportunity.AF_InvoiceBalance__c, which AF_VR_Opp_TakeTheKeysGate and AF_VR_Opp_ClosedWonGate read.</description>
    <environments>Default</environments>
    <interviewLabel>Invoice Summary Sync Opportunity Balance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Invoice Summary Sync Opportunity Balance</label>
    <loops>
        <name>Loop_Invoice_Summaries</name>
        <label>Loop Invoice Summaries</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <collectionReference>Get_Invoice_Summaries</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_To_Total</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Opportunity_Balance</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Invoice_Summaries</name>
        <label>Get Invoice Summaries for Opportunity</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Invoice_Summaries</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AF_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AF_Opportunity__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AF_InvoiceSummary__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity_Balance</name>
        <label>Update Opportunity Balance</label>
        <locationX>302</locationX>
        <locationY>350</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AF_Opportunity__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AF_InvoiceBalance__c</field>
            <value>
                <elementReference>var_TotalBalance</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Invoice_Summaries</targetReference>
        </connector>
        <object>AF_InvoiceSummary__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_TotalBalance</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
