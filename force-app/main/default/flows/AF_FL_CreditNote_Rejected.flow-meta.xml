    <actionCalls>
        <name>Send_Owner_Rejection</name>
        <label>Send Owner Rejection Email</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <actionName>AF_CreditNote__c.AF_EA_CreditNote_Rejected</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Get_NotificationType</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>AF_CreditNote__c.AF_EA_CreditNote_Rejected</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_RecipientId</name>
        <label>Assign Recipient Id</label>
        <locationX>176</locationX>
        <locationY>402</locationY>
        <assignmentItems>
            <assignToReference>var_RecipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Notification</targetReference>
        </connector>
    </assignments>
    <description>Fires when AF_ApprovalStatus__c changes to Rejected. Notifies the Credit Note Owner via email and Custom Notification - same dual-channel pattern as AF_FL_Reservation_Rejected.</description>
    <environments>Default</environments>
    <formulas>
        <name>AF_Formula_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Rejected: Cancellation/Refund &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>NotifBody</name>
        <dataType>String</dataType>
        <expression>&quot;Your cancellation/refund request &quot; &amp; {!$Record.Name} &amp; &quot; was rejected.&quot;</expression>
    </formulas>
    <formulas>
        <name>NotifTitle</name>
        <dataType>String</dataType>
        <expression>&quot;Cancellation/Refund Rejected: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <interviewLabel>Credit Note Rejected {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Credit Note Rejected</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_NotificationType</name>
        <label>Get Notification Type</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_RecipientId</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>AF_NT_Alfardan_Alert</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Owner_User_ForEmail</name>
        <label>Get Owner User (for Email)</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Send_Owner_Rejection</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Owner_User_ForEmail</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.AF_ApprovalStatus__c}) &amp;&amp; ISPICKVAL({!$Record.AF_ApprovalStatus__c}, &quot;Rejected&quot;)</filterFormula>
        <object>AF_CreditNote__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_RecipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
