            <field>ApplicationFormProductId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>applicationFormProductId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Stage</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Final</stringValue>
            </value>
        </filters>
        <filters>
            <field>SelectedBy</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lender</stringValue>
            </value>
