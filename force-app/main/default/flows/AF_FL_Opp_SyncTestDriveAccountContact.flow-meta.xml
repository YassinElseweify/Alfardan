<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Backfill_Account_Contact</name>
        <label>Backfill Account/Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_TestDrives.AF_Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ResolvedAccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_TestDrives.AF_Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ResolvedContactId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_TestDrivesToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_TestDrives</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_TestDrives</targetReference>
        </connector>
    </assignments>
    <description>AF_FL_Opp_CreateExploreSideProcesses only seeds AF_TestDrive__c.AF_Account__c/AF_Contact__c once, at the moment of the Consider-to-Explore transition. If AccountId or AF_PrimaryBrandContact__c is set/corrected on the Opportunity afterward, any already-created Test Drive with those fields still blank never catches up (found live: TD-00014, Account added to the Opportunity after its Test Drive was auto-created). Backfills only — never overwrites a value a user already set on the Test Drive.</description>
    <environments>Default</environments>
    <formulas>
        <name>ResolvedAccountId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Loop_TestDrives.AF_Account__c}), {!$Record.AccountId}, {!Loop_TestDrives.AF_Account__c})</expression>
    </formulas>
    <formulas>
        <name>ResolvedContactId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Loop_TestDrives.AF_Contact__c}), {!$Record.AF_PrimaryBrandContact__c}, {!Loop_TestDrives.AF_Contact__c})</expression>
    </formulas>
    <interviewLabel>AF Opp Sync Test Drive Account Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Sync Test Drive Account Contact</label>
    <loops>
        <name>Loop_TestDrives</name>
        <label>Loop Test Drives</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_TestDrives_Missing_Data</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Backfill_Account_Contact</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_TestDrives</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_TestDrives_Missing_Data</name>
        <label>Get Test Drives Missing Data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_TestDrives</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>AF_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AF_Account__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AF_Contact__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AF_TestDrive__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_TestDrives</name>
        <label>Update Test Drives</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>var_TestDrivesToUpdate</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_TestDrives_Missing_Data</targetReference>
        </connector>
        <filterFormula>OR(
    ISCHANGED({!$Record.AccountId}),
    ISCHANGED({!$Record.AF_PrimaryBrandContact__c})
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_TestDrivesToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AF_TestDrive__c</objectType>
    </variables>
</Flow>
