    <formulas>
        <description>Generates the account name by concatenating the first name and the last name of the account for a service catalog request.</description>
        <name>AccountNameFormula</name>
        <dataType>String</dataType>
        <expression>{!IterateOverServiceCatalogRequestExtendedAttributeValues.SvcCatalogRequest.Case.Account.FirstName}&amp;IF(NOT(ISBLANK({!IterateOverServiceCatalogRequestExtendedAttributeValues.SvcCatalogRequest.Case.Account.FirstName})),&quot; &quot;,&quot;&quot;)&amp;{!IterateOverServiceCatalogRequestExtendedAttributeValues.SvcCatalogRequest.Case.Account.LastName}</expression>
    </formulas>
    <formulas>
        <description>Returns the last four digits of the financial account number.</description>
        <name>MaskedFinancialAccountNumberFormula</name>
        <dataType>String</dataType>
        <expression>IF(
        LEN({!FinancialAccountNumber}) &gt; 4,
        LPAD(RIGHT({!FinancialAccountNumber}, 4), LEN({!FinancialAccountNumber}), &quot;X&quot;),
        LPAD(RIGHT({!FinancialAccountNumber}, 1), LEN({!FinancialAccountNumber}), &quot;X&quot;)
    )</expression>
    </formulas>
    <formulas>
        <description>Generates the recurring due day by using the number or integer value that is in the loop.</description>
        <name>RequestedRecurringDueDayFormula</name>
        <dataType>Number</dataType>
        <expression>IF(
  NOT( ISNULL({!IterateOverServiceCatalogRequestExtendedAttributeValues.NumberValue}) ),
  {!IterateOverServiceCatalogRequestExtendedAttributeValues.NumberValue},
  {!IterateOverServiceCatalogRequestExtendedAttributeValues.IntegerValue}
)</expression>
        <scale>0</scale>
    </formulas>
