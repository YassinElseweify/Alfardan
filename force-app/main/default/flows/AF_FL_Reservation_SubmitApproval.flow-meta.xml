        <nameSegment>submit</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>After-save on AF_VehicleReservation__c, paired with the before-save AF_FL_Reservation_EvaluateApproval. Submits the record into AF_AP_Reservation_Manager only on the transition into Pending (ISNEW or ISCHANGED), never on a later unrelated save while already Pending, since re-submitting an in-flight approval request errors.</description>
    <environments>Default</environments>
    <interviewLabel>Reservation Submit Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reservation Submit Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Submit_For_Approval</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.AF_ApprovalStatus__c}, &quot;Pending&quot;) &amp;&amp; (ISNEW() || ISCHANGED({!$Record.AF_ApprovalStatus__c}))</filterFormula>
        <object>AF_VehicleReservation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
