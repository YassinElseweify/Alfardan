<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Every new cancellation/refund request must go through approval, so a blank Approval Status is defaulted to Pending on create. Before-save, no extra DML.</description>
    <environments>Default</environments>
    <interviewLabel>Credit Note Set Approval Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Credit Note Set Approval Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Pending</name>
        <label>Set Approval Status - Pending</label>
        <locationX>50</locationX>
        <locationY>134</locationY>
        <inputAssignments>
            <field>AF_ApprovalStatus__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Pending</targetReference>
        </connector>
        <filterFormula>ISBLANK(TEXT({!$Record.AF_ApprovalStatus__c}))</filterFormula>
        <object>AF_CreditNote__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
