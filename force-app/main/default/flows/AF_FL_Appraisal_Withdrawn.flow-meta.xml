<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_QuoteLines_To_Delete</name>
        <label>Has Trade-In Deduction Lines To Delete?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Stamp_Withdrawn_Audit</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None Found - Skip Delete</defaultConnectorLabel>
        <rules>
            <name>Lines_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_TradeIn_QuoteLines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_TradeIn_QuoteLines</targetReference>
            </connector>
            <label>Lines Found</label>
        </rules>
    </decisions>
    <description>LFRDN-634: fires when Trade-In Outcome changes to Withdrawn. Deletes any Trade-In Deduction QuoteLineItem(s) referencing this Appraisal (queried directly via QuoteLineItem.AF_RelatedTradeIn__c rather than trusting Appraisal.AF_RelatedQuoteLine__c alone, in case that reverse-pairing field was never kept in sync), records a Withdrawn-By/Date audit stamp on the Appraisal, and creates a Task logging the withdrawal for visibility. Deposit reversal was scoped out - see Jira comment: AF_VehicleReservation__c has no direct lookup to a specific Appraisal (only a same-Opportunity AF_TradeInAsDeposit__c checkbox with no way to identify which trade-in it refers to when more than one exists on the same Opportunity), so automating a specific deposit reversal here would risk reversing the wrong one. Fix (LFRDN-634, 2026-09-08): added Has_QuoteLines_To_Delete guard before Delete_TradeIn_QuoteLines - deleting an empty/zero-match recordLookups reference directly faults at runtime (&quot;No records in Salesforce match your delete criteria&quot;) even with assignNullValuesIfNoRecordsFound false; the delete is now skipped entirely (routing straight to the audit stamp) when no matching lines exist. RETIRED 2026-09-08: deactivated in favor of AF_FL_Appraisal_TradeInWithdrawn, which duplicates this flow&apos;s quote-line deletion/audit logic and additionally covers deposit reversal via AF_RelatedVehicleReservation__c - keeping one flow as the single source of truth rather than two Active flows on the same trigger.</description>
    <environments>Default</environments>
    <formulas>
        <name>Var_TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Trade-In Withdrawn - &quot; &amp; {!$Record.AppraisalNumber} &amp; &quot; (quote line(s) removed)&quot;</expression>
    </formulas>
    <interviewLabel>Appraisal Withdrawn {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Appraisal Withdrawn</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Audit_Task</name>
        <label>Create Withdrawal Audit Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Trade-In Outcome set to Withdrawn. Linked Trade-In Deduction quote line(s), if any, were removed automatically. Review whether any deposit tied to this trade-in also needs manual reversal (no automated link exists between a specific trade-in and a specific reservation deposit).</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Var_TaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordDeletes>
        <name>Delete_TradeIn_QuoteLines</name>
        <label>Delete Trade-In Deduction Quote Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Withdrawn_Audit</targetReference>
        </connector>
        <inputReference>Get_TradeIn_QuoteLines</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>Get_TradeIn_QuoteLines</name>
        <label>Get Trade-In Deduction Quote Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_QuoteLines_To_Delete</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AF_RelatedTradeIn__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AF_LineItemType__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Trade-In Deduction</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Stamp_Withdrawn_Audit</name>
        <label>Stamp Withdrawn Audit Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Audit_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AF_WithdrawnBy__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_WithdrawnDate__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Appraisal</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_TradeIn_QuoteLines</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.AF_TradeInOutcome__c}) &amp;&amp; ISPICKVAL({!$Record.AF_TradeInOutcome__c}, &quot;Withdrawn&quot;)</filterFormula>
        <object>Appraisal</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
