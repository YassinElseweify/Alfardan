    <actionCalls>
        <description>Calls an action that creates a service appointment based on a diagnostic trouble code. The action takes the service territory IDs and Work Group ID as input and returns Service Appointment ID as an output.</description>
        <name>ScheduleServiceAppointmentForActionableEvent</name>
        <label>Schedule Service Appointment for Actionable Event</label>
        <locationX>176</locationX>
        <locationY>1082</locationY>
        <actionName>scheduleSvcApptActnblEvntOrch</actionName>
        <actionType>scheduleSvcApptActnblEvntOrch</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>workTypeGroupId</name>
            <value>
                <elementReference>GetWorkTypeGroup.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>serviceTerritoryIds</name>
            <value>
                <elementReference>ServiceTerritoryIds</elementReference>
            </value>
        </inputParameters>
