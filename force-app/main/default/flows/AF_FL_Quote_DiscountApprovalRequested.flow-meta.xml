    <description>Fires when AF_DiscountApprovalStatus__c becomes Pending. Notifies the approver (Owner&apos;s Manager) via branded HTML email and Custom Notification - same dual-channel pattern as AF_FL_Reservation_ApprovalRequested. logEmailOnSend+relatedRecordId=$Record.Id added so the email logs as an EmailMessage on the Quote&apos;s own Emails/Activity related list (previously sent but not logged anywhere).</description>
    <environments>Default</environments>
    <formulas>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;html&gt;&lt;body style=&quot;margin:0;padding:16px;background-color:#F4F4F6;font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;div style=&quot;max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:6px;border:1px solid #E2E5EA;border-top:4px solid #0B2545;padding:20px 24px;&quot;&gt;&lt;span style=&quot;display:inline-block;background-color:#FCEFC7;color:#8A6D00;font-size:12px;font-weight:bold;letter-spacing:0.04em;text-transform:uppercase;padding:4px 10px;border-radius:3px;&quot;&gt;Action Required&lt;/span&gt;&lt;h2 style=&quot;margin:12px 0;font-size:18px;color:#0B2545;&quot;&gt;A Quote discount needs your approval&lt;/h2&gt;&lt;p style=&quot;margin:0 0 6px;font-size:14px;color:#4A4A4A;&quot;&gt;Quote: &lt;strong&gt;&apos; &amp; {!$Record.Name} &amp; &apos;&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 0 6px;font-size:14px;color:#4A4A4A;&quot;&gt;Owner: &lt;strong&gt;&apos; &amp; {!Get_Owner_User.Name} &amp; &apos;&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 0 6px;font-size:14px;color:#4A4A4A;&quot;&gt;Discount Amount: &lt;strong&gt;&apos; &amp; TEXT({!$Record.AF_DiscountAmount__c}) &amp; &apos;&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 0 16px;font-size:14px;color:#4A4A4A;&quot;&gt;Discount %: &lt;strong&gt;&apos; &amp; TEXT({!$Record.AF_DiscountPercent__c}) &amp; &apos;&lt;/strong&gt;&lt;/p&gt;&lt;a href=&quot;&apos; &amp; {!Var_ApprovalLink} &amp; &apos;&quot; style=&quot;display:inline-block;padding:10px 18px;background:#0B2545;color:#fff;text-decoration:none;border-radius:4px;font-size:13px;&quot;&gt;Review Approval Request&lt;/a&gt;&lt;/div&gt;&lt;/body&gt;&lt;/html&gt;&apos;</expression>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Approval Needed: Quote Discount &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>NotifBody</name>
        <dataType>String</dataType>
        <expression>&quot;A discount on Quote &quot; &amp; {!$Record.Name} &amp; &quot; needs your approval.&quot;</expression>
    </formulas>
    <formulas>
        <name>NotifTitle</name>
        <dataType>String</dataType>
        <expression>&quot;Approval Needed: Quote Discount &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>Var_ApprovalLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_260})) &amp; &quot;/lightning/o/ProcessInstanceWorkitem/home&quot;</expression>
    </formulas>
