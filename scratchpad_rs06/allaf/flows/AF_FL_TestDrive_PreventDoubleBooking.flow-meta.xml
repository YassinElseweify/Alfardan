<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Double_Booking_Error</name>
        <label>Double Booking Error</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <customErrorMessages>
            <errorMessage>This vehicle is already booked for the selected date and time slot. Choose a different slot or vehicle.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Has_Conflict</name>
        <label>Has Conflict?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Conflict_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Conflicting_TestDrive</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Double_Booking_Error</targetReference>
            </connector>
            <label>Conflict Found</label>
        </rules>
    </decisions>
    <description>Record-page-level double-booking guard, complementing the picker&apos;s own real-time slot check (AF_TestDriveSchedulerController.getBookedSlots). Conflict key is exact AF_Vehicle__c + AF_TestDriveDateTime__c match on another record — the scheduler always derives AF_TestDriveDateTime__c deterministically from Date + AF_TimeSlot__c, so two bookings for the same vehicle/date/slot always produce identical DateTime values. Cancelled and Refused bookings don&apos;t hold the slot (LFRDN-623).</description>
    <environments>Default</environments>
    <interviewLabel>AF Test Drive Prevent Double Booking {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test Drive Prevent Double Booking</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Conflicting_TestDrive</name>
        <label>Get Conflicting Test Drive</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Conflict</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AF_Vehicle__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AF_Vehicle__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>AF_TestDriveDateTime__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AF_TestDriveDateTime__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AF_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>AF_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Refused</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AF_TestDrive__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Conflicting_TestDrive</targetReference>
        </connector>
        <filterFormula>AND(
    NOT(ISBLANK({!$Record.AF_Vehicle__c})),
    NOT(ISBLANK({!$Record.AF_TestDriveDateTime__c})),
    OR(
        ISNEW(),
        ISCHANGED({!$Record.AF_Vehicle__c}),
        ISCHANGED({!$Record.AF_TestDriveDateTime__c})
    )
)</filterFormula>
        <object>AF_TestDrive__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
