<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Fires exactly once per Consider-to-Explore transition (prior stage was literally Consider, current stage is Explore - not just &quot;entered Explore from anywhere&quot;), so it does not re-fire on later saves while already in Explore. Auto-creates one AF_TestDrive__c and one Appraisal (PurposeType=Trade-In) linked to the Opportunity, both seeded from the Opportunity&apos;s Account/Brand/Primary Contact. If the Opportunity later cycles back to Consider and forward to Explore again, this fires again and creates a fresh pair - that is a deliberate reading of the BRD text (auto-create &quot;when the Opportunity progresses from Consider to Explore&quot;), not a dedup gap. Also carries forward the Lead-side test-drive interest (Lead Convert already maps AF_TestDriveDateTime__c/AF_TestDriveLocation__c onto the Opportunity&apos;s AF_CarriedTestDrive* fields) so a customer&apos;s pre-stated preference isn&apos;t lost — if a date/time was captured, the new Test Drive starts as Scheduled instead of Requested.</description>
    <environments>Default</environments>
    <formulas>
        <name>TestDriveInitialStatus</name>
        <dataType>String</dataType>
        <expression>IF(
    OR(
        ISBLANK({!$Record.AF_CarriedTestDriveDateTime__c}),
        ISBLANK({!$Record.AF_CarriedTestDriveLocation__c})
    ),
    &quot;Requested&quot;,
    &quot;Scheduled&quot;
)</expression>
    </formulas>
    <interviewLabel>Opportunity Create Explore Side Processes {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Create Explore Side Processes</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Appraisal</name>
        <label>Create Trade-In Appraisal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AF_Account__c</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_Brand__c</field>
            <value>
                <elementReference>$Record.AF_Brand__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_BusinessUnit__c</field>
            <value>
                <elementReference>$Record.AF_BusinessUnit__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_Contact__c</field>
            <value>
                <elementReference>$Record.AF_PrimaryBrandContact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_InitiatingSalesRep__c</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PurposeType</field>
            <value>
                <stringValue>Trade-In</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ReferenceRecordId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UsageType</field>
            <value>
                <stringValue>Automotive</stringValue>
            </value>
        </inputAssignments>
        <object>Appraisal</object>
    </recordCreates>
    <recordCreates>
        <name>Create_TestDrive</name>
        <label>Create Test Drive</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Appraisal</targetReference>
        </connector>
        <inputAssignments>
            <field>AF_Account__c</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_Contact__c</field>
            <value>
                <elementReference>$Record.AF_PrimaryBrandContact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_Location__c</field>
            <value>
                <elementReference>$Record.AF_CarriedTestDriveLocation__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_Opportunity__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_Status__c</field>
            <value>
                <elementReference>TestDriveInitialStatus</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_TestDriveDateTime__c</field>
            <value>
                <elementReference>$Record.AF_CarriedTestDriveDateTime__c</elementReference>
            </value>
        </inputAssignments>
        <object>AF_TestDrive__c</object>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_TestDrive</targetReference>
        </connector>
        <filterFormula>AND(
    ISPICKVAL({!$Record__Prior.StageName}, &quot;Consider&quot;),
    ISPICKVAL({!$Record.StageName}, &quot;Explore&quot;)
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>40</triggerOrder>
</Flow>
