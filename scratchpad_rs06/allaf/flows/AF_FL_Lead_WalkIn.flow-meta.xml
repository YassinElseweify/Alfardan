    <decisions>
        <name>Decide_Gate</name>
        <label>Walk-In Lead Creation Enabled for this Business Unit?</label>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_NotEnabled</targetReference>
