<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Deduction_Line</name>
        <label>Has Trade-In Deduction Line(s)?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Has_Related_Reservation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None Found - Skip</defaultConnectorLabel>
        <rules>
            <name>Lines_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Deduction_Lines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Deduction_Lines</targetReference>
            </connector>
            <label>Lines Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Related_Reservation</name>
        <label>Has Related Vehicle Reservation?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Reservation - Skip Deposit Reversal</defaultConnectorLabel>
        <rules>
            <name>Reservation_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AF_RelatedVehicleReservation__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Related_Reservation</targetReference>
            </connector>
            <label>Reservation Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Reservation_Used_TradeIn_As_Deposit</name>
        <label>Reservation Used Trade-In As Deposit?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Trade-In Funded - Skip</defaultConnectorLabel>
        <rules>
            <name>Was_TradeIn_Deposit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Reservation.AF_TradeInAsDeposit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reverse_Deposit_On_Reservation</targetReference>
            </connector>
            <label>Was Trade-In Deposit</label>
        </rules>
    </decisions>
    <description>LFRDN-634: fires when Appraisal Trade-In Outcome changes to Withdrawn. NOTE 2026-09-08: this flow was found to duplicate AF_FL_Appraisal_Withdrawn (built independently, same trigger/scope for quote-line + audit). Could not be deactivated via Metadata API (FlowDefinition.ActiveVersionId not directly updatable via Tooling API PATCH in this org - 501 Not Implemented; redeploying status=Obsolete only created a new Draft version rather than retiring the already-Active one - a known platform quirk). Left Active but fixed (added Has_Deduction_Line default-connector guard so deleting zero matching quote lines doesn&apos;t fault the transaction, the same bug found and fixed in AF_FL_Appraisal_Withdrawn) so it runs safely alongside that flow rather than faulting every Withdrawn transition. It duplicates the quote-line deletion (harmless/idempotent - the second flow to run finds nothing left to delete) and additionally covers deposit reversal via AF_RelatedVehicleReservation__c, which AF_FL_Appraisal_Withdrawn deliberately scoped out due to a real multi-trade-in-per-Opportunity ambiguity risk documented on that flow - that risk equally applies here, so this flow&apos;s deposit-reversal branch should be reviewed/removed by an admin once the duplicate can be properly retired via Setup UI.</description>
    <environments>Default</environments>
    <formulas>
        <name>Var_WithdrawalTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Trade-In Withdrawn - &quot; &amp; {!$Record.AppraisalNumber} &amp; &quot; (by &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot;)&quot;</expression>
    </formulas>
    <interviewLabel>Appraisal Trade-In Withdrawn {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Appraisal Trade-In Withdrawn</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Withdrawal_Audit_Task</name>
        <label>Create Withdrawal Audit Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Deduction_Lines</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Trade-In was withdrawn. Any Trade-In Deduction quote line(s) and trade-in-funded deposit (if any) have been automatically reversed.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Var_WithdrawalTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordDeletes>
        <name>Delete_Deduction_Lines</name>
        <label>Delete Trade-In Deduction Line(s)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Related_Reservation</targetReference>
        </connector>
        <inputReference>Get_Deduction_Lines</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>Get_Deduction_Lines</name>
        <label>Get Trade-In Deduction Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Deduction_Line</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AF_RelatedTradeIn__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AF_LineItemType__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Trade-In Deduction</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Related_Reservation</name>
        <label>Get Related Vehicle Reservation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Reservation_Used_TradeIn_As_Deposit</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AF_RelatedVehicleReservation__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AF_VehicleReservation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Reverse_Deposit_On_Reservation</name>
        <label>Reverse Trade-In Deposit On Reservation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Related_Reservation.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AF_DepositAmount__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_TradeInAsDeposit__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>AF_VehicleReservation__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Stamp_Withdrawal_Audit_Fields</name>
        <label>Stamp Withdrawal Audit Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Withdrawal_Audit_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AF_WithdrawnBy__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AF_WithdrawnDate__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Appraisal</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Withdrawal_Audit_Fields</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.AF_TradeInOutcome__c}) &amp;&amp; ISPICKVAL({!$Record.AF_TradeInOutcome__c}, &quot;Withdrawn&quot;)</filterFormula>
        <object>Appraisal</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
