<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Category_Already_Set</name>
        <label>Category Already Set?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Which_Record_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Blank</defaultConnectorLabel>
        <rules>
            <name>Already_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AF_ContactCategory__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Already Set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Which_Record_Type</name>
        <label>Which Record Type?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Is_Brand_Profile</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AF_Brand_Profile</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Brand_Profile</targetReference>
            </connector>
            <label>Is Brand Profile</label>
        </rules>
        <rules>
            <name>Is_Related_Person</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AF_Related_Person</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Related_Person</targetReference>
            </connector>
            <label>Is Related Person</label>
        </rules>
    </decisions>
    <description>Stamps Contact.AF_ContactCategory__c from the record type on create, since only AF_LeadConversionService.cls sets it today and any Contact created directly (e.g. via the standard New button under an Account) was left with a blank category. Before-save, no extra DML. Only fires when the field is blank so a deliberate manual value is never overwritten.</description>
    <environments>Default</environments>
    <interviewLabel>Contact Set Category {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Set Category</label>
    <processMetadataValues>
        <name>BuilderType</name>
