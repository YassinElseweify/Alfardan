<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Submit_For_Approval</name>
        <label>Submit for Approval</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>AF_AP_Quote_DiscountTiers</stringValue>
            </value>
        </inputParameters>
        <nameSegment>submit</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>After-save on Quote, paired with the before-save AF_FL_Quote_SetDiscountApprovalStatus. Submits the record into AF_AP_Quote_DiscountTiers only on the transition into Pending, never on a later unrelated save while already Pending, since re-submitting an in-flight approval request errors. Renamed from the original AF_AP_Quote_Discount when that process needed a genuine 4-tier rebuild to match the confirmed DoA matrix - Salesforce permanently locks an approval process&apos;s steps once it has any submission history, so a new process was required rather than editing in place.</description>
    <environments>Default</environments>
    <interviewLabel>Quote Submit Discount Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Submit Discount Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Submit_For_Approval</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.AF_DiscountApprovalStatus__c}, &quot;Pending&quot;) &amp;&amp; (ISNEW() || ISCHANGED({!$Record.AF_DiscountApprovalStatus__c}))</filterFormula>
        <object>Quote</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
