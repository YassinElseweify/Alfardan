    <description>Fires when AF_LostApprovalStatus__c changes to Rejected. Notifies the rep via Task (kept for the Activity History trail) and via a Custom Notification (AF_NT_Alfardan_Alert, looked up by DeveloperName rather than hardcoded Id so this flow stays portable across environments). Title/body are built from formulas referencing the Opportunity Name, not hardcoded text. Does NOT reset AF_LostApprovalStatus__c back to Not Submitted -- that used to happen here and immediately overwrote the Approval Process&apos;s own &quot;Rejected&quot; field update in the same transaction, making rejections look like they never happened. The reset to Not Submitted now belongs in AF_FL_Opp_RequestClosure, at the point the rep actually starts a new closure request.</description>
    <environments>Default</environments>
    <formulas>
        <name>EmailBody_Rejected</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;html&gt;&lt;body style=&quot;margin:0;padding:16px;background-color:#F4F4F6;font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;center&gt;&lt;table role=&quot;presentation&quot; align=&quot;center&quot; width=&quot;100%&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot;&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;&lt;table role=&quot;presentation&quot; align=&quot;center&quot; width=&quot;100%&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;max-width:560px;width:100%;background-color:#FFFFFF;border-radius:6px;border:1px solid #E2E5EA;border-top:4px solid #0B2545;margin:0 auto;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:24px 24px 8px 24px;&quot;&gt;&lt;span style=&quot;display:inline-block;background-color:#FBE2E1;color:#B3261E;font-size:12px;font-weight:bold;letter-spacing:0.04em;text-transform:uppercase;padding:4px 10px;border-radius:3px;&quot;&gt;Rejected&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 24px 0 24px;&quot;&gt;&lt;h2 style=&quot;margin:0;font-size:19px;color:#0B2545;&quot;&gt;Your Closed Lost request was rejected&lt;/h2&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:16px 24px 4px 24px;&quot;&gt;&lt;table role=&quot;presentation&quot; width=&quot;100%&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#6B7280;font-size:13px;width:120px;&quot;&gt;Opportunity&lt;/td&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#1A1A1A;font-size:14px;&quot;&gt;&apos; &amp; {!$Record.Name} &amp; &apos;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#6B7280;font-size:13px;&quot;&gt;Account&lt;/td&gt;&lt;td style=&quot;padding:10px 0;border-bottom:1px solid #EDEEF1;color:#1A1A1A;font-size:14px;&quot;&gt;&apos; &amp; {!Get_Account.Name} &amp; &apos;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px 0;color:#6B7280;font-size:13px;&quot;&gt;Lost Reason submitted&lt;/td&gt;&lt;td style=&quot;padding:10px 0;color:#1A1A1A;font-size:14px;&quot;&gt;&apos; &amp; TEXT({!$Record.AF_LostReason__c}) &amp; &apos;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px 24px 20px 24px;&quot;&gt;&lt;p style=&quot;margin:0;font-size:14px;line-height:20px;color:#4A4A4A;&quot;&gt;Please review and follow up as needed.&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 24px 24px 24px;&quot;&gt;&lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; align=&quot;center&quot; style=&quot;margin:0 auto;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border-radius:4px;background-color:#0B2545;&quot;&gt;&lt;a href=&quot;&apos; &amp; {!Var_RecordLink} &amp; &apos;&quot; target=&quot;_blank&quot; style=&quot;display:inline-block;padding:12px 22px;font-size:14px;font-weight:bold;color:#FFFFFF;text-decoration:none;&quot;&gt;View Opportunity&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:16px 24px;background-color:#FAFAFB;border-top:1px solid #EDEEF1;&quot;&gt;&lt;p style=&quot;margin:0;font-size:12px;color:#9AA0AC;&quot;&gt;Alfardan Group CRM - This is an automated notification.&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/center&gt;&lt;/body&gt;&lt;/html&gt;&apos;</expression>
    </formulas>
